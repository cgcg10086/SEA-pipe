#! /bin/bash

set -x

project_dir=PROJECT_DIR
tile_list=TILELIST

# In a job array, SLURM gives every task its own number. A job that is not an array has no such number.
if [[ -n "${SLURM_ARRAY_TASK_ID}" ]]; then
    taskid="${SLURM_ARRAY_TASK_ID}"
    jobid="${SLURM_ARRAY_JOB_ID}"
else
    taskid=1
    jobid="${SLURM_JOB_ID}"
fi

# Every line of the tile list is: an obsid, then the tile indices to flag. Task N reads line N.
line=$(sed -n "${taskid}p" "${project_dir}/${tile_list}")
read -r obsid flags <<< "${line}"     # the first word goes into obsid, the rest into flags

# start
if [[ "${GXTRACK}" == "track" ]]; then
    track_task.py start --jobid=${jobid} --taskid=${taskid} --start_time=`date +%s`
fi

cd "${project_dir}/${obsid}" || exit 1

if [[ -n "${flags}" ]]; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') # INFO # Flagging tiles ${flags} in ${obsid}.ms"
    flagantennae "${obsid}.ms" ${flags} || exit 1

    # Keep a record, because the flags now live inside the measurement set.
    # Later steps (for example the choice of the reference tile) read this file.
    echo "${flags}" >> "${obsid}_flagged_tiles.txt"
else
    echo "$(date '+%Y-%m-%d %H:%M:%S') # INFO # No tiles to flag for ${obsid}."
fi

if [[ "${GXTRACK}" == "track" ]]; then
    track_task.py finish --jobid=${jobid} --taskid=${taskid} --finish_time=`date +%s`
fi

