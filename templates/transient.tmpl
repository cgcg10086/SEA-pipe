#! /bin/bash

# A template imaging script to search for transient sources.
# This requires that a deep clean using the normal obs_image.sh
# to have populated the data model column first.

set -x

obsinp=OBSINP
ramcopy=RAMCOPY
project_dir=PROJECT_DIR
debug=DEBUG

# Which data column to image
if [[ -n "${debug}" ]]; then
    datacolumn="CORRECTED_DATA"
else
    datacolumn="DATA"
fi

# If obsinp is a file, then we are in an array job
if [[ -f "${obsinp}" ]]; then
    taskid="${SLURM_ARRAY_TASK_ID}"
    jobid="${SLURM_ARRAY_JOB_ID}"
    obsid="$(sed -n -e ${SLURM_ARRAY_TASK_ID}p ${obsinp})"
    tmpdir="/tmp/slurm_transient_${jobid}_${taskid}"
else
    taskid=1
    jobid="${SLURM_JOB_ID}"
    obsid="${obsinp}"
    tmpdir="/tmp/slurm_transient_${jobid}"
fi

test_fail() {
    if [[ $1 != 0 ]]; then
        if [[ "${GXTRACK}" == "track" ]]; then
            "${GXBASE}/sea_src/bin/track_task.py" fail --jobid="${jobid}" --taskid="${taskid}" --finish_time="$(date +%s)"
        fi
        exit "$1"
    fi
}

# Update database
if [[ "${GXTRACK}" == "track" ]]; then
    "${GXBASE}/sea_src/bin/track_task.py" start --jobid="${jobid}" --taskid="${taskid}" --start_time="$(date +%s)"
fi

data_dir="${project_dir}/${obsid}"
cd "${data_dir}" || exit

metafits="${obsid}.metafits"
if [[ ! -f "${metafits}" ]] || [[ ! -s "${metafits}" ]]; then
    wget -O "${metafits}" "http://ws.mwatelescope.org/metadata/fits?obs_id=${obsid}"
    test_fail $?
fi

