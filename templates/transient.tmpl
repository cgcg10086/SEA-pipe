# make one image for each time interval (determined by obs_manta -t; read from The measurement set’s TIME column. Each time step has one time, the centre of its integration.)
# count the existing ${obsid}_transient-t????-image.fits files. Run WSClean only if the count differs from intervals_out, so a re-run does not redo finished work.
# -subtract-model	Subtract the model in MODEL_DATA, written by the deep clean, from the data.
# -no-update-model-required	Do not overwrite MODEL_DATA, so the model stays intact
# Use the time steps from start up to but not including stop, and make N separate images 
if [[ "$(ls "${obsid}"_transient-t????-image.fits 2>/dev/null | wc -l)" -ne $intervals_out ]]; then
    wsclean \
        -name "${obsid}_transient" \
        -gridder wgridder \
        -abs-mem "${PROGMEMORY}" \
        -data-column "${datacolumn}" \
        -subtract-model \
        -pol I \
        -size "${size}" "${size}" \
        -minuv-l "${minuv_l}" \
        -taper-inner-tukey "${taper_inner_tukey}" \
        -taper-gaussian "${taper}" \
        -niter "${niter}" \
        -auto-threshold "${auto_threshold}" \
        -scale "${scale:0:8}" \
        -log-time \
        -no-reorder \
        -no-update-model-required \
        -intervals-out "${intervals_out}" \
        "${ms}"
        # -nwlayers "${IMNCPUS}" \ # deprecated in 3.7  
        # -interval "${interval_start}" "${interval_stop}" \ # Image every time step
    test_fail $?
fi

