#     coords="$(calc_pointing.py ${metafits})"
#     echo "$(date '+%Y-%m-%d %H:%M:%S') # INFO # Optimally shifting co-ordinates of measurement set to $coords, with zenith shiftback."
#     chgcentre "${ms}" "${coords}"
    
#     # Now shift the pointing centre to point straight up, which approximates minw without making the phase centre rattle around
#     chgcentre -zenith -shiftback "${ms}"
