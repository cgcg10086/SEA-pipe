# NIGHT uses one array configuration (the MWA long-baseline array).
basescale=0.6     # the same as in image.tmpl; the pixel size is basescale / chan 

# Set up channel-dependent options
chan="$("${GXBASE}/sea_src/bin/pyhead.py" -p CENTCHAN "${metafits}" | awk '{print $3}')"

# Settings to support transient imaging / cleaning
niter=12000
size=2400
taper=2amin
auto_threshold=3
minuv_l=50 # use 40 to be consistent with imaging? 
taper_inner_tukey=50 # use 400 to be consistent with imaging? 

# Pixel scale
# At least 2 pix per synth beam for each channel
# Original 'scale=1amin' was from the IPS version of the code
# Decreasing the scale to be 2 pixels per BMIN, was originally 4 in
# normal imaging mode.
scale=$(echo "${basescale} / ${chan} * 2" | bc -l)

if [[ -n "${ramcopy}" ]]; then
    mkdir -p "${tmpdir}"
    cp -r "${obsid}.ms" "${tmpdir}/"
    ms="${tmpdir}/${obsid}.ms"
else
    ms="${obsid}.ms"
fi

# # Skipping first and last 8 seconds
# interval_start=$((8/timeres))
# ninterval=$(taql "calc count([select distinct(TIME) from ${ms}])")
# interval_stop=$((ninterval-interval_start))
# intervals_out=$((interval_stop-interval_start))

# Image every time step: no time steps are skipped at the start or the end.
ninterval=$(taql "calc count([select distinct(TIME) from ${ms}])") 
intervals_out="${ninterval}" 

# WSClean 3.7 no longer supports chgcentre -shiftback. wgridder handles w-terms,
# so no phase-centre change is needed (same as image.tmpl).
