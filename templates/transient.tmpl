# test_fail $?

# Make a cube and a standard deviation image
"${GXBASE}/sea_src/bin/make_time_cube.py" "${obsid}"_transient    
test_fail $?

# Dump the image and model files into a hdf5 container
# "${GXBASE}/sea_src/bin/make_imstack.py" --start 0 -n "${intervals_out}" "${obsid}_transient"
# test_fail $?

# Save the flags
taql "select ctod(TIME), gsum(ntrue(amplitude(DATA[,::3])==0.0)), gsum(ntrue(FLAG[,::3])), gmean(WEIGHT_SPECTRUM[,::3]) from ${ms} where ANTENNA1 != ANTENNA2 groupby TIME" > "${obsid}_summary.txt"

# Move back the measurement set to the original location if we copied it to RAM
if [[ -n "${ramcopy}" ]]; then
    rm -rf "${data_dir}/${obsid}.ms"
    mv "${ms}" "${data_dir}/"
    rm -rf "${tmpdir}"
fi

# Clean up
rm "${obsid}"_transient-t????-*.fits
# rm "${obsid}_transient_concatenated_table.fits"

if [[ "${GXTRACK}" == "track" ]]; then
    "${GXBASE}/sea_src/bin/track_task.py" finish --jobid="${jobid}" --taskid="${taskid}" --finish_time="$(date +%s)"
fi
