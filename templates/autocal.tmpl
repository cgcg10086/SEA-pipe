#!/bin/bash

set -x

obsinp=OBSINP
ramcopy=RAMCOPY # Copy the measurement set to RAM for processing? (blank means no)
project_dir=PROJECT_DIR
fraction=FRACTION
ionotest=IONOTEST # Perform ionospheric triage? (blank means no)

# If obsinp is a file, then we are in an array job
if [[ -f "${obsinp}" ]]; then
    taskid="${SLURM_ARRAY_TASK_ID}"
    jobid="${SLURM_ARRAY_JOB_ID}"
    obsid="$(sed -n -e ${SLURM_ARRAY_TASK_ID}p ${obsinp})"
    tmpdir="/tmp/slurm_autocal_${jobid}_${taskid}"
else
    taskid=1
    jobid="${SLURM_JOB_ID}"
    obsid="${obsinp}"
    tmpdir="/tmp/slurm_autocal_${jobid}"
fi

test_fail() {
    if [[ $1 != 0 ]]; then
        if [[ "${GXTRACK}" == "track" ]]; then
            track_task.py fail --jobid="${jobid}" --taskid="${taskid}" --finish_time="$(date +%s)"
        fi
        exit "$1"
    fi
}

# # Setting the reference antenna
# if [[ "${obsid}" -gt 1201000000 ]] && [[ "${obsid}" -lt 1201400000 ]]; then refant=8
# elif [[ "${obsid}" -gt 1300000000 ]] && [[ "${obsid}" -lt 1342950000 ]]; then refant=0
# elif [[ "${obsid}" -gt 1342950000 ]] && [[ "${obsid}" -lt 1425294600 ]]; then refant=8
# elif [[ "${obsid}" -gt 1425294600 ]] && [[ "${obsid}" -lt 1436999999 ]]; then refant=0
# elif [[ "${obsid}" -gt 1451700000 ]] && [[ "${obsid}" -lt 1451800000 ]]; then refant=8 # Jan 2026
# elif [[ "${obsid}" -ge 1452536120 ]] && [[ "${obsid}" -le 1452542632 ]]; then refant=21
# else refant=7 # Everything else
# fi

# Reference tile: the first tile that is not flagged in the metafits
# refant=$(python - "${metafits}" <<'PY'
# import sys
# from astropy.io import fits

# with fits.open(sys.argv[1]) as hdus:
#     tiles = hdus["TILEDATA"].data
#     print(tiles["Antenna"][tiles["Flag"] == 0][0])
# PY
# )

refant=$(python3 ${GXBASE}/sea_src/bin/find_reference_tile.py "${metafits}") # first unflagged tile in metafits
test_fail $?
echo "$(date '+%Y-%m-%d %H:%M:%S') # INFO # Reference tile (first unflagged tile in the metafits): ${refant}"

# GLEAM-X sky model
catfile="${SOFTBASE}/sky_models/GGSM_updated.fits"

# MWA beam information
MWAPATH="${GXMWAPB}"

# The gains are fitted only on intermediate baselines.  
# Exclude short baselines: diffuse emission that a point-source catalogue doesn’t contain.
# Exclude long baselines: resolve structure that the GLEAM-based sky model (about 2′ resolution) can’t describe.

# Baseline range for calibration, in wavelengths.
# The 1667 lambda maximum corresponds to the longest 128T baseline at 200 MHz.
minuv=75
maxuv=1667

# start

if [[ "${GXTRACK}" == "track" ]]; then
    track_task.py start --jobid="${jobid}" --taskid="${taskid}" --start_time="$(date +%s)"
fi

data_dir="${project_dir}/${obsid}"
cd "${data_dir}" || exit

metafits="${obsid}.metafits"
if [[ ! -f "${metafits}" ]] || [[ ! -s "${metafits}" ]]; then
    wget -O "${metafits}" "http://ws.mwatelescope.org/metadata/fits?obs_id=${obsid}"
    test_fail $?
fi

# In RAM or here?
if [[ -n "${ramcopy}" ]]; then
    mkdir -p "${tmpdir}"
    cp -r "${obsid}.ms" "${tmpdir}"
    ms="${tmpdir}/${obsid}.ms"
else
    ms="${obsid}.ms"
fi

echo "$(date '+%Y-%m-%d %H:%M:%S') # INFO # Running infield calibration for ${obsid}"
# Record the phase centre in the log (read only; nothing in the pipeline shifts it any more)
chgcentre "${ms}"

# removed the shift check & shift back to optimal pointing 
# calibrator=$(pyhead.py -p CALIBSRC "$metafits" | awk '{print $3}' )
# echo "$(date '+%Y-%m-%d %H:%M:%S') # INFO # Calibrator is ${calibrator}"

# echo "$(date '+%Y-%m-%d %H:%M:%S') # INFO # Running infield calibration for ${obsid}"
# RA=$(pyhead.py -p RA "$metafits" | awk '{print $3}' )
# Dec=$(pyhead.py -p DEC "$metafits" | awk '{print $3}' )
# chan=$(pyhead.py -p CENTCHAN "$metafits" | awk '{print $3}' )

# # Inspect the measurement set's phase centre; chgcentre reports "shift" when it has
# # already been shifted, which must be handled before calibration.
# current=$(chgcentre "${ms}") 

# if [[ $current == *"shift"* ]]; then
#     echo "$(date '+%Y-%m-%d %H:%M:%S') # INFO # Detected that this measurement set has undergone a denormal shift; this must be undone before calibration."
#     # Get the optimal pointing coordinates from the observation metadata-- the sky position where the primary beam is strongest.
#     # Highly off-zenith pointings have their beam peak far from the nominal pointing. 
#     # When the phase centre was moved to the beam peak-- not useful for NIGHT.
#     coords=$(calc_optimum_pointing.py --metafits "${metafits}")
#     echo "$(date '+%Y-%m-%d %H:%M:%S') # INFO # Optimally shifting co-ordinates of measurement set to ${coords}, without zenith shiftback."
#     # Rephase the measurement set to those coordinates, without applying a zenith shiftback.
#     chgcentre "${ms}" "${coords[@]}"
# else
#     echo "$(date '+%Y-%m-%d %H:%M:%S') # INFO # Detected that this measurement set has not yet had its phase centre changed. Not shifting."
# fi

# # uv range for calibration based on GLEAM-based sky model
# # Calibrate takes a maximum uv range in metres
# # Calculate min uvw in metres
# minuvm=$(echo "234 * ${minuv} / ${chan}" | bc -l)
# # In wavelengths, maximum 128T baseline at 200MHz was 1667 lambda long
# # 300/1.28 * 1667 = 390000
# # Calculate max uvw in metres
# maxuvm=$(echo "390000 / (${chan} + 11)" | bc -l)

# hyperdrive compares the data visibilities with visibilities predicted from a sky model, and uses the differences to calculate antenna gains. 
# It iterates until the gains converge or it reaches --max-iterations. 
# Result: one complex 2×2 matrix per tile and per frequency channel (XX, XY, YX, YY).
# Diagonal terms (J_XX, J_YY): gX and gY in plots.
# Off-diagonal terms (J_XY, J_YX): leakage, a little of one polarisation appearing in the other. DX and DY. 
# leakage should be << gX, gY. Otherwise, flag that file. 

if [[ -n "${ionotest}" ]]; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') # INFO # Performing ionospheric triage."

    ntimesteps=`taql "calc count([select distinct(TIME) from ${ms}])"`
    # Break the observation into 3 chunks of ntimesteps/3 timesteps each.
    chunk_size=$(echo "$ntimesteps / 3" | bc)

    # Ionospheric triage
    solutions1="${obsid}_local_gleam_model_solutions_ts1.bin"
    hyperdrive \
        di-calibrate \
        --max-iterations 500 \
        --timesteps $(eval echo {0..$(echo "$chunk_size - 1" | bc)}) \
        --num-sources 500 \
        --uvw-min "${minuv}lambda" \
        --uvw-max "${maxuv}lambda" \
        --beam-file "${MWAPATH}/mwa_full_embedded_element_pattern.h5" \
        --outputs "${solutions1}" \
        -d "${ms}" "${metafits}" \
        -s "${catfile}"
    
    hyperdrive \
        solutions-plot \
        --ref-tile "${refant}" \
        --max-amp 2 \
        -m "${metafits}" \
        "${solutions1}" 

    solutions="${obsid}_local_gleam_model_solutions_ts2.bin"
    hyperdrive \
        di-calibrate \
        --timesteps $(eval echo {$chunk_size..$(echo "2 * $chunk_size - 1" | bc)}) \
        --max-iterations 500 \
        --num-sources 1000 \
        --uvw-min "${minuv}lambda" \
        --uvw-max "${maxuv}lambda" \
        --beam-file "${MWAPATH}/mwa_full_embedded_element_pattern.h5" \
        --outputs "${solutions}" \
        -d "${ms}" "${metafits}" \
        -s "${catfile}"

    hyperdrive \
        solutions-plot \
        --ref-tile "${refant}" \
        --max-amp 2 \
        -m "${metafits}" \
        "${solutions}"

    solutions="${obsid}_local_gleam_model_solutions_ts3.bin"
    hyperdrive \
        di-calibrate \
        --timesteps $(eval echo {$(echo "2 * $chunk_size" | bc)..$(echo "$ntimesteps - 1" | bc)}) \
        --max-iterations 500 \
        --num-sources 1000 \
        --uvw-min "${minuv}lambda" \
        --uvw-max "${maxuv}lambda" \
        --beam-file "${MWAPATH}/mwa_full_embedded_element_pattern.h5" \
        --outputs "${solutions}" \
        -d "${ms}" "${metafits}" \
        -s "${catfile}"

    hyperdrive \
        solutions-plot \
        --ref-tile "${refant}" \
        --max-amp 2 \
        -m "${metafits}" \
        "${solutions}" 

    echo "Ionospheric calibration finished. Creating plots and statistics. "

    python3 "${GXBASE}/sea_src/bin/aocal_diff.py" --metafits="${metafits}" --names --lastsol "${solutions}" "${solutions1}" --refant="${refant}"
    if [[ -n "${GXDBHOST}" ]] && [[ -n "${GXDBPORT}" ]] && [[ -n "${GXDBUSER}" ]] && [[ -n "${GXDBPASS}" ]]; then
        iono_update.py --ionocsv "${obsid}_ionodiff.csv"
    fi
fi

# At the moment, assume that the ionosphere is OK, and derive some real solutions
solutions="${obsid}_local_gleam_model_solutions_initial.bin"

# calibrate
hyperdrive \
    di-calibrate \
    --uvw-min "${minuv}lambda" \
    --max-iterations 500 \
    --num-sources 500 \
    --uvw-max "${maxuv}lambda" \
    --beam-file "${MWAPATH}/mwa_full_embedded_element_pattern.h5" \
    --outputs "${solutions}" \
    -d "${ms}" "${metafits}" \
    -s "${catfile}"
test_fail $?

# Create a version divided through by the reference antenna, so that all observations have the same relative XY phase, allowing polarisation calibration solutions to be transferred
# This also sets the cross-terms to zero by default, unless --preserve_xterms
aocal_phaseref.py "${solutions}" "${solutions%.bin}_ref.bin" "${refant}" --xy -2.806338586067941065e+01 --dxy -4.426533296449057023e-07  --ms "${obsid}.ms"
test_fail $?

# plot calibration solutions
hyperdrive \
    solutions-plot \
    --ref-tile "${refant}" \
    --max-amp 2 \
    -m "${metafits}" \
    "${solutions%.bin}_ref.bin"

test_fail $?

# Test to see if the calibration solution meets minimum quality control. At the moment
# this is a simple check based on the number of flagged solutions
result=$(check_assign_solutions.py -t "${fraction}" check "${solutions%.bin}_ref.bin")
if echo "${result}" | grep -q fail; then
    mv "${solutions%.bin}_ref.bin" "${solutions%.bin}_ref_failed.bin"
    test_fail 1
fi

# Move back the measurement set to the original location if we copied it to RAM
if [[ -n "${ramcopy}" ]]; then
    rm -rf "${data_dir}/${obsid}.ms"
    mv "${ms}" "${data_dir}/"
    rm -rf "${tmpdir}"
fi

if [[ "${GXTRACK}" == "track" ]]; then
    track_task.py finish --jobid="${jobid}" --taskid="${taskid}" --finish_time="$(date +%s)"
fi
